{
  "name": "claude-help",
  "productName": "Claude Help",
  "version": "0.1.0",
  "description": "Claude 账号额度看板与收信工具",
  "author": "ZhaoMCX",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.zhaomcx.claudehelp",
    "productName": "Claude Help",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../skills",
        "to": "skills"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Claude Help"
    },
    "publish": {
      "provider": "github",
      "owner": "ZhaoMCX",
      "repo": "claude-help",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
