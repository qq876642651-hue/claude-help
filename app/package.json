{
  "name": "claude-help",
  "productName": "Claude Help",
  "version": "0.4.0",
  "description": "Claude 账号额度看板与收信工具（含 claude-help 命令行）",
  "author": "ZhaoMCX",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "bin": {
    "claude-help": "src/cli.js"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node src/cli.js",
    "dist": "electron-builder --win nsis --publish never",
    "version:next": "node scripts/release.mjs --dry-run",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "com.zhaomcx.claudehelp",
    "productName": "Claude Help",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "build/claude-help.cmd",
        "to": "claude-help.cmd"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Claude Help",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "qq876642651-hue",
      "repo": "claude-help",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
